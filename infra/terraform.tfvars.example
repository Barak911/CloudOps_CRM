# ──────────────────────────────────────────────────────────────
# CloudOps CRM — Terraform Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars — it is gitignored.
# ──────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────

# GitHub username or org (used for OIDC trust policy)
github_repo_owner = "<your-github-username>"

# CIDRs allowed to reach the EKS public API endpoint.
# REQUIRED — there is intentionally no default, so a wide-open API
# is a conscious choice and not a silent fallback. Set to your VPN
# or office egress range, e.g. ["203.0.113.0/24"].
# Use ["0.0.0.0/0"] ONLY if you knowingly want a public API endpoint
# (e.g. for a throwaway demo cluster — combine with the IAM access
# entries already created in eks.tf to keep authn tight).
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# ── Optional (defaults shown) ────────────────────────────────

# IAM ARN for kubectl access (your AWS user or role).
# Defaults to empty: the cluster creator already gets admin via
# enable_cluster_creator_admin_permissions, so this is only needed
# when a different principal needs view/edit on specific namespaces.
# developer_user_arn = "arn:aws:iam::<ACCOUNT_ID>:user/<username>"

# Networking. Default = true (custom VPC with private subnets + NAT).
# Set to false to reuse the AWS default VPC — faster bootstrap, but
# nodes get public IPs and the security posture is meaningfully worse.
# use_custom_vpc = true
# vpc_cidr       = "10.0.0.0/16"

# aws_region         = "us-east-1"
# cluster_name       = "cloudops-eks-cluster"
# cluster_version    = "1.31"
# ecr_repository_name = "crm-app"
# github_repo_name   = "CloudOps_CRM"

# Exclude AZs that don't support EKS (e.g. us-east-1e)
# excluded_availability_zones = ["us-east-1e"]

# ── Backend config (passed via terraform init, not here) ─────
# terraform init \
#   -backend-config="bucket=<your-state-bucket>" \
#   -backend-config="region=<your-bucket-region>"
