provider "aws" {
  region = var.aws_region
}

# Kubernetes provider for creating cluster resources (StorageClass, etc.)
provider "kubernetes" {
  host                   = module.eks.cluster_endpoint
  cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name]
  }
}

# Helm provider for the substrate controllers (ArgoCD, ESO, cert-manager,
# Karpenter). Same auth as the kubernetes provider — `aws eks get-token` is
# resolved at apply time, so the provider can be configured before the
# cluster exists.
provider "helm" {
  kubernetes {
    host                   = module.eks.cluster_endpoint
    cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

    exec {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name]
    }
  }
}

# kubectl provider for raw manifests (App-of-Apps root, ClusterSecretStore,
# repo-cred ExternalSecret). Avoids the plan-time server-side validation
# that breaks kubernetes_manifest on first apply.
provider "kubectl" {
  host                   = module.eks.cluster_endpoint
  cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)
  load_config_file       = false

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name]
  }
}
